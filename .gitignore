# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.Python

# 构建产物
build/
dist/
release/
*.spec.bak

# 运行时数据
.cache/
.guopian/
_guopian_rejected/
catalogs/
guopian.portable

# 模型按需下载，不进仓库：人脸检测 3.6 MB，照片向量 3.7 MB
models/*.task
models/*.onnx

# 运行日志写在 user_data_dir() 里，不在仓库中。它会记下用户的真实目录路径
# （D:\image cache\...），而仓库是公开的，所以绝不能提交。
*.log

# 本地评估数据 —— 你自己的照片永远不该进仓库
evaluation/testset/
evaluation/mytestset/
evaluation/labels.csv

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Kimi WebBridge 的运行时状态
evaluation/.bridge_state.json
evaluation/.anim_probe.js

# 浏览器探针写回读的临时文件
_cdp.json
_exit_*.png

# Chromium 和 matplotlib 会在 TEMP 里丢临时目录，而这里的 TEMP 就在仓库内，
# 一次截图会留下几个 tmpXXXXXX/，每个装着 400 KB 字体缓存。可再生，永远没用。
# tmp_split/ 故意不忽略：它放着重构前的原始文件。
/tmp*/
!/tmp_split/

# 引导用的演示照片，运行时生成
demo-photos/

# 应用窗口用的 Chromium profile：含 cookie 和存储，按需重建，绝不提交
window-profile/

# prefs.json 记录用户自己文件夹的路径
prefs.json
prefs.json.bak
*.bak

# 调试截图（截图脚本把临时图写到 docs/img/ 下）
docs/img/_*.png
