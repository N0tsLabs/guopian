/* 过片 Guopian — the layer every other script stands on.
 *
 * @requires web/index.html   the views and the #toast element
 * @requires /api/*           only through G.api
 *
 * Loaded FIRST. home.js and app.js both destructure from window.G, so this file
 * has no opinion about either of them -- which is the point. It used to live at
 * the top of home.js, i.e. the shared foundation was buried inside a view, and
 * app.js depended on a file it had no relationship with. The load order was
 * written down in a comment and nothing enforced it.
 *
 * Plain <script>, no modules, no build step. */

const G = (() => {
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));

  async function api(path, opts) {
    const r = await fetch(path, Object.assign(
      { headers: { 'Content-Type': 'application/json' } }, opts || {}));
    const ct = r.headers.get('content-type') || '';
    const body = ct.includes('json') ? await r.json() : await r.text();
    if (!r.ok) throw Object.assign(new Error((body && body.message) || ('HTTP ' + r.status)),
                                  { body, status: r.status });
    return body;
  }

  let toastTimer = null;
  function toast(msg, kind) {
    const t = $('#toast');
    if (!t) return;
    t.textContent = msg;
    t.className = 'toast ' + (kind || '');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.add('hidden'), 2800);
  }

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g,
      c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  const sleep = ms => new Promise(r => setTimeout(r, ms));

  function fmtCount(n) {
    return n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(n);
  }

  return { $, $$, api, toast, esc, sleep, fmtCount };
})();
window.G = G;

/* ═══════════════════════════════ 视图切换 ═══════════════════════════════ */

const Views = {
  show(name) {
    ['homeView', 'appView', 'gridView'].forEach(id => {
      G.$('#' + id).classList.toggle('hidden', id !== name);
    });
  },
};
window.Views = Views;
