/* 过片 Guopian — the card flow.
 *
 *  键盘：见 ? 帮助面板。三个决定的用词来自 config.DECISION_LABELS，
 *  经 /api/home 下发，这个文件里不写死 —— 改词只需要改 config.py 一处。
 *
 *  Nothing pressed means "not reviewed yet" — that is the whole pending state,
 *  which is why there is no 待定 or 跳过 button.
 *
 *  按住先预览，松手才真的决定。底部那几个按钮也可以直接用鼠标点。
 *  鼠标：滚轮缩放、拖动平移、双击 100%、未放大时左右拖拽。
 *
 *  @requires web/core.js       G ( $ $$ api toast esc sleep fmtCount ), loads first
 *  @requires web/index.html    every id this file looks up
 *  @requires /api/home         labels, and `current` when a library is open
 *  @requires /api/state        counts, issue_summary, labels
 *  @requires /api/queue        the list and the card order
 *  @requires window.Home       the folder browser and the back-to-home path
 *
 *  Loaded as a plain <script> — no modules, no build step — and attaches itself
 *  to window.App at the bottom. It is one file on purpose for now; splitting it
 *  is planned, and this header is what will make that mechanical.
 */

const App = (() => {
  // Everything comes from core.js. This file knows nothing about home.js.
  const { $, $$, api, toast, esc, sleep, fmtCount } = G;

  const el = {};
  const S = {
    state: null, queue: [], idx: 0, detail: null, running: false,
    showOverlay: false,        // 人脸框默认关闭，不遮挡照片
    showZebra: false,
    listOpen: true,
    // 'all' by default: the list is a file list, not a to-do queue. With
    // 'pending' a finished project showed an empty list and no way back.
    filter: 'all', sort: 'time',
    sel: new Set(),
    busy: false, poll: null, generation: -1,
  };

  const V = {
    s: 1, tx: 0, ty: 0, bw: 0, bh: 0, aspect: 0,
    areaW: 0, areaH: 0,      // the viewport the image is fitted into
    natW: 0, natH: 0,        // the currently loaded file
    origW: 0, origH: 0,      // the photo's real dimensions, from the catalog
    fullReady: false,
  };

  const HOLD_CLASS = { reject: 'hold-reject', keep: 'hold-keep', mark: 'hold-mark' };
  const RELEASE_CLASS = { reject: 'release-reject', keep: 'release-keep', mark: 'release-mark' };
  // The three judgements and their ONE set of user-facing names.
  // Everything in the UI reads this -- toolbar, list, badges, toasts,
  // apply panel -- so the vocabulary cannot drift apart again.
  /* The three decision words, FILLED FROM THE SERVER at startup.
   *
   * They used to be written out here as literals, which made this the second
   * place they existed -- config.DECISION_LABELS is the first, and index.html
   * carried several more as bare text. Renaming a decision therefore took four
   * edits and missing one produced no error at all, just a screen showing two
   * different words for the same thing.
   *
   * Empty until setLabels() runs. That is deliberate: a use before startup is a
   * visible blank rather than a silently wrong word. */
  const LABEL = { keep: '', reject: '', mark: '' };
  // The software's suggestion, and the badge for a decision you have made.
  // Both are DERIVED from the decision words, so they come from the same
  // place -- see config.DECISION_VERDICT / DECISION_OWNED.
  const VERDICT = { keep: '', reject: '', maybe: '' };
  const OWNED = { keep: '', reject: '', mark: '' };

  function setLabels(labels) {
    if (!labels) return;
    const take = (target, src) => {
      if (!src) return;
      for (const k of Object.keys(target)) if (src[k]) target[k] = src[k];
    };
    take(LABEL, labels.decisions);
    take(VERDICT, labels.verdict);
    take(OWNED, labels.owned);
    // Anything already on screen was rendered with the old words.
    if (S.state) { renderTriage(S.state); renderListSummary(); }
  }
  // How long each departure takes. They differ on purpose: a discard should
  // feel like it is falling away, a keep like it is being filed, and 收藏 has
  // to fit a whole stamping gesture in before the card leaves.
  // These must stay >= the CSS animation durations (see evaluation/anim_check.py).
  const EXIT_MS = { reject: 400, keep: 440, mark: 540 };
  const UNMARK_MS = 370;

  // ── drag gesture ──
  // Nothing at all happens inside DRAG_DEAD: that explicit neutral zone is what
  // stops the middle of a drag from flickering between 不要 and 要. The old
  // threshold was 18px, so merely wobbling across the centre flipped the whole
  // overlay to the other colour.
  const DRAG_DEAD = 26;      // px of travel that means "I have not decided"
  const DRAG_COMMIT = 138;   // px past which releasing decides

  // ── throwing ──
  // A card is not only dragged, it is flicked. Velocity at release decides two
  // things: whether the gesture counts at all (a quick flick should not have to
  // travel 138px first), and how far and how fast it goes.
  const FLING_MIN_V = 0.55;  // px/ms at release (550 px/s) to count as a throw
  const FLING_MAX = 2.6;     // px/ms that saturates the throw

  function setDragProgress(pl, pr, pm) {
    const s = el.photoStage.style;
    s.setProperty('--pl', (pl || 0).toFixed(3));
    s.setProperty('--pr', (pr || 0).toFixed(3));
    s.setProperty('--pm', (pm || 0).toFixed(3));
  }

  function grab() {
    Object.assign(el, {
      root: $('#rootLabel'), stats: $('#stats'), roBadge: $('#roBadge'),
      progressFill: $('#progressFill'), progressText: $('#progressText'),
      cardWrap: $('#cardWrap'), photoStage: $('#photoStage'), photo: $('#photo'),
      photoHD: $('#photoHD'), photoLayer: $('#photoLayer'), photoCard: $('#photoCard'),
      zebra: $('#zebra'), overlay: $('#overlay'), issueTags: $('#issueTags'),
      histo: $('#histo'), histoCanvas: $('#histoCanvas'), metaLine: $('#metaLine'),
      groupBadge: $('#groupBadge'), verdictBadge: $('#verdictBadge'),
      previewVeil: $('#previewVeil'), previewStamp: $('#previewStamp'),
      zoomBadge: $('#zoomBadge'), decisionBadge: $('#decisionBadge'),
      emptyState: $('#emptyState'), emptyTitle: $('#emptyTitle'), emptyHint: $('#emptyHint'),
      triage: $('#triage'), triageChips: $('#triageChips'),
      listPane: $('#listPane'), listScroll: $('#listScroll'), listTitle: $('#listTitle'),
      listCount: $('#listCount'), listProgressFill: $('#listProgressFill'),
      listSummary: $('#listSummary'), listJump: $('#listJump'), listJumpLabel: $('#listJumpLabel'),
      listShow: $('#listShow'), listHide: $('#listHide'),
      gridView: $('#gridView'), grid: $('#grid'), gridSort: $('#gridSort'),
      gridFilter: $('#gridFilter'), gridCount: $('#gridCount'),
      modal: $('#modal'), sheet: $('#sheet'), help: $('#help'), browser: $('#browser'),
      coach: $('#coach'),
    });
  }

  /* ═════════════════════════ 生命周期 ═════════════════════════ */

  function start() {
    if (!S.running) { grab(); bind(); S.running = true; }
    S.filter = 'all'; S.idx = 0;
    loadState().then(loadQueue);
    tick();
    showCoachOnce();
  }

  function attach() {
    if (!S.running) { grab(); bind(); S.running = true; }
    loadState().then(loadQueue);
    tick();
  }

  function stop() {
    clearInterval(S.poll); S.poll = null;
    S.queue = []; S.idx = 0;
  }

  function tick() {
    clearInterval(S.poll);
    S.poll = setInterval(loadState, 4000);
  }

  async function loadState() {
    let st;
    try { st = await api('/api/state'); }
    catch (e) {
      if (e.status === 409) { stop(); Views.show('homeView'); Home.refresh(); }
      return;
    }
    S.state = st;
    if (S.generation !== -1 && st.generation !== S.generation) loadQueue();
    S.generation = st.generation;

    el.root.textContent = st.root; el.root.title = st.root;
    el.roBadge.classList.toggle('hidden', !st.read_only);
    renderStats(st);
    renderProgress(st.progress);
    renderTriage(st);
  }

  function renderStats(st) {
    const d = st.counts.decisions || {};
    const reviewed = (d.keep || 0) + (d.reject || 0) + (d.mark || 0);
    const left = Math.max(0, (st.counts.total || 0) - reviewed);
    const parts = [`<span>共 <b>${st.counts.total}</b></span>`];
    if (d.keep) parts.push(`<span style="color:#7ee787">${LABEL.keep} <b>${d.keep}</b></span>`);
    if (d.reject) parts.push(`<span style="color:#ffa39c">${LABEL.reject} <b>${d.reject}</b></span>`);
    if (d.mark) parts.push(`<span style="color:#f5cd5c">${LABEL.mark} <b>${d.mark}</b></span>`);
    parts.push(`<span>未审 <b>${left}</b></span>`);
    const fa = st.face_available || {};
    if (!fa.ok) parts.push(`<span style="color:#f0c850" title="${esc(fa.message || '')}">人脸检测未启用</span>`);
    el.stats.innerHTML = parts.join('');
  }

  function renderProgress(p) {
    const pct = p.total ? Math.round(100 * p.done / p.total) : 0;
    el.progressFill.style.width = pct + '%';
    if (p.running) {
      el.progressText.textContent =
        `${p.phase === 'scan' ? '扫描' : '分析'} ${p.done}/${p.total} · ${p.rate || 0}/s` +
        (p.eta ? ` · 剩 ~${Math.ceil(p.eta)}s` : '');
    } else if (p.phase === 'done') {
      el.progressText.textContent = `分析完成 · ${p.elapsed}s`;
    } else if (p.phase === 'error') {
      el.progressText.textContent = '分析出错，见日志';
    } else {
      el.progressText.textContent = p.message || '';
    }
  }

  function renderTriage(st) {
    const defs = [
      ['all', '全部'], ['pending', '未审'], ['keep', LABEL.keep],
      ['reject', LABEL.reject], ['mark', LABEL.mark],
      ['issues', '有明显问题'], ['faces', '有人脸'], ['groups', '连拍 / 相似组'],
    ];
    const chips = defs.map(([f, label]) =>
      `<button class="chip ${S.filter === f ? 'on' : ''}" data-f="${f}">${label}</button>`);
    for (const it of (st.issue_summary || [])) {
      chips.push(`<button class="chip ${S.filter === 'issue:' + it.kind ? 'on' : ''}"
        data-f="issue:${it.kind}">${esc(it.label_zh)}<span class="n">${it.n}</span></button>`);
    }
    el.triageChips.innerHTML = chips.join('');
    $$('.chip', el.triageChips).forEach(c => {
      c.onclick = () => { S.filter = c.dataset.f; S.idx = 0; loadQueue(); renderTriage(S.state); };
    });
    const gf = el.gridFilter;
    if (gf && !gf.options.length) {
      gf.innerHTML = defs.map(([v, t]) => `<option value="${v}">${t}</option>`).join('');
    }
    const titles = { all: '全部照片', pending: '未审', keep: LABEL.keep,
                     reject: LABEL.reject, mark: LABEL.mark };
    el.listTitle.textContent = titles[S.filter] ||
      (S.filter === 'issues' ? '有明显问题'
        : S.filter === 'faces' ? '有人脸'
        : S.filter === 'groups' ? '连拍 / 相似组'
        : S.filter.startsWith('issue:') ? '按问题筛选' : S.filter);
  }

  /* ═════════════════════════ 队列 + 左侧列表 ═════════════════════════ */

  async function loadQueue() {
    let q;
    try { q = await api(`/api/queue?filter=${encodeURIComponent(S.filter)}&sort=${encodeURIComponent(S.sort)}`); }
    catch (e) { return; }
    S.queue = q.items || [];
    S.idx = pickStartIndex();
    renderList();
    render();
  }

  const cur = () => S.queue[S.idx] || null;

  /* ── where to put the cursor when a list loads ──
     Reopening a project should land you back where you were, not at the top.
     If we have nothing remembered, start at the first photo that still needs
     a decision -- that is almost always what you came back to do. */
  function posKey() {
    return 'guopian.pos.' + ((S.state && S.state.root) || '');
  }

  function savedPos() {
    try { return parseInt(localStorage.getItem(posKey()) || '0', 10) || 0; }
    catch (e) { return 0; }
  }

  function savePos(id) {
    try { localStorage.setItem(posKey(), String(id)); } catch (e) { /* ignore */ }
  }

  function pickStartIndex() {
    if (!S.queue.length) return 0;
    const id = savedPos();
    if (id) {
      const at = S.queue.findIndex(c => c.id === id);
      if (at >= 0) return at;
    }
    const firstOpen = S.queue.findIndex(c => !c.decision);
    return firstOpen >= 0 ? firstOpen : 0;
  }

  function itemHTML(c, i) {
    const flags = (c.issues || []).slice(0, 2)
      .map(x => `<span class="sev-${x.severity}">${esc(x.label_zh)}</span>`).join(' · ');
    return `<button class="listItem ${c.decision || ''}" data-i="${i}" data-id="${c.id}">
      <span class="bar"></span>
      <span class="thumbWrap">
        <img data-src="/img/${c.id}/small" alt="">
        <span class="num">${i + 1}</span>
      </span>
      <span class="info">
        <span class="nm">${esc(c.name)}</span>
        <span class="fl">${flags || (c.group_size > 1 ? `相似组 ${c.group_rank}/${c.group_size}` : '')}</span>
      </span>
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"
             stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
      </span>
    </button>`;
  }

  let thumbObserver = null;
  function observeThumbs() {
    if (thumbObserver) thumbObserver.disconnect();
    thumbObserver = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        const img = en.target;
        thumbObserver.unobserve(img);
        const src = img.dataset.src;
        if (src) {
          img.onload = () => img.classList.add('loaded');
          img.src = src;
        }
      }
    }, { root: el.listScroll, rootMargin: '300px 0px' });
    $$('img[data-src]', el.listScroll).forEach(im => {
      // item 0 is visible immediately; give the ones already on screen a head start
      thumbObserver.observe(im);
    });
  }

  function renderList() {
    el.listScroll.innerHTML = S.queue.map(itemHTML).join('');
    observeThumbs();
    highlightCurrent();
    updateListProgress();
    renderListSummary();
    $$('.listItem', el.listScroll).forEach(it => {
      it.onclick = () => { S.idx = +it.dataset.i; render(); };
    });
  }

  /** Colour-coded tally at the top of the list. Clicking one filters to it. */
  function renderListSummary() {
    // Counts come from the WHOLE library (state.counts.decisions), never from
    // S.queue. S.queue is the currently FILTERED list, so counting it meant that
    // clicking 要 produced { keep: 69 } and nothing else -- the other three
    // chips then had a count of zero, were filtered out of the row, and there
    // was no way back to them. The switcher deleted itself.
    const d = (S.state && S.state.counts && S.state.counts.decisions) || {};
    const n = {
      none: d.undecided || 0,
      keep: d.keep || 0,
      reject: d.reject || 0,
      mark: d.mark || 0,
    };
    const rows = [['none', '未审', 'pending'], ['keep', LABEL.keep, 'keep'],
                  ['reject', LABEL.reject, 'reject'], ['mark', LABEL.mark, 'mark']];
    // All four are ALWAYS rendered, at zero included: they are how you switch
    // between views, not a summary of whatever happens to be on screen. The
    // active one is marked rather than the others being removed.
    el.listSummary.innerHTML = rows
      .map(([k, label, f]) =>
        `<button class="sumChip ${k} ${S.filter === f ? 'on' : ''}" data-f="${f}"` +
        ` title="只看${label}"><i></i>${label} <b>${n[k]}</b></button>`).join('');
    $$('.sumChip', el.listSummary).forEach(b => {
      b.onclick = () => {
        // Clicking the active one clears the filter, so the row is also the way
        // back to everything.
        S.filter = (S.filter === b.dataset.f) ? 'all' : b.dataset.f;
        S.idx = 0;
        loadQueue();
        // Keep the filtering bar at the top in step with the one in the list.
        renderTriage(S.state);
      };
    });

    // The jump label is about THIS list, so it does count the queue.
    let open = 0;
    for (const c of S.queue) if (!c.decision) open++;
    el.listJump.classList.toggle('done', open === 0);
    el.listJumpLabel.textContent = open
      ? `下一张未审（还有 ${open} 张）`
      : '这个列表里都审完了';
  }

  function highlightCurrent() {
    const prev = el.listScroll.querySelector('.listItem.current');
    if (prev) prev.classList.remove('current');
    const now = el.listScroll.querySelector(`.listItem[data-i="${S.idx}"]`);
    if (now) {
      now.classList.add('current');
      now.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
  }

  function updateListProgress() {
    const decided = S.queue.filter(c => c.decision).length;
    const pct = S.queue.length ? decided / S.queue.length * 100 : 0;
    el.listProgressFill.style.width = pct + '%';
    el.listCount.textContent = `${decided}/${S.queue.length}`;
  }

  function markListItem(i, decision) {
    const it = el.listScroll.querySelector(`.listItem[data-i="${i}"]`);
    if (!it) return;
    it.classList.remove('keep', 'reject', 'mark', 'pulse');
    if (decision) it.classList.add(decision);
    // Restart the highlight so a re-decision on the same row still registers.
    void it.offsetWidth;
    it.classList.add('pulse');
    updateListProgress();
    renderListSummary();
  }

  /* ═════════════════════════ 卡片 ═════════════════════════ */

  function render() {
    const c = cur();
    if (!c) {
      el.photoStage.classList.add('hidden');
      el.emptyState.classList.remove('hidden');
      el.emptyTitle.textContent = S.queue.length === 0
        ? (S.filter === 'all' ? '这个库里还没有照片' : '这个筛选条件下没有照片')
        : '看完了';
      el.emptyHint.innerHTML = S.queue.length === 0
        ? (S.filter === 'all'
            ? '如果刚打开文件夹，稍等它扫描完。'
            : '换个筛选条件看看 —— 试试点上面的「全部」。')
        : '这一批都处理完了。可以换个条件继续，或者点右上角「应用决策」。';
      el.issueTags.innerHTML = el.overlay.innerHTML = '';
      el.metaLine.textContent = '';
      el.verdictBadge.innerHTML = '';
      el.decisionBadge.classList.add('hidden');
      el.histo.style.display = 'none';
      highlightCurrent();
      return;
    }
    el.photoStage.classList.remove('hidden');
    el.emptyState.classList.add('hidden');
    el.histo.style.display = '';
    resetHoldVisual();

    // Set the photo's REAL dimensions BEFORE laying out, and lay out now.
    //
    // fitStage() prefers these over el.photo.naturalWidth precisely so it can
    // run before the preview has loaded. Previously it only ran from onload, so
    // the arriving card kept the PREVIOUS photo's box for the ~250ms the 71 KB
    // preview took to arrive -- and then got resized part-way through its
    // arrival animation. Measured: 4 of every 30 adjacent pairs differ in aspect
    // ratio by more than 0.02, and each of those was a visible jump.
    V.origW = c.width || 0;
    V.origH = c.height || 0;
    fitStage();

    // Arrival: the card rises into the slot from below, every time.
    //
    // There is deliberately NO second element standing in for it any more. A
    // peek of the next photo was laid out in the CURRENT photo's box, so
    // whenever the two had different aspect ratios the peek had to be resized
    // -- instantly, while its position still transitioned -- and that read as a
    // twitch. Portrait to portrait barely changed size, which is why only some
    // turns looked wrong. One element, one animation, nothing to keep in sync.
    el.photoCard.style.visibility = '';
    el.photoCard.classList.remove('entering');
    void el.photoCard.offsetWidth;
    el.photoCard.classList.add('entering');

    el.photo.classList.add('loading');
    el.photo.onload = () => {
      el.photo.classList.remove('loading');
      fitStage();
      // Render it from the image, not from a guess: at this point src was
      // just assigned, so a cache miss means naturalWidth was still 0 and the
      // first draw bailed out. Without this the histogram stayed empty on
      // every cold load and only appeared when the file was already cached.
      drawHistogram();
    };
    el.photo.src = `/img/${c.id}/card`;

    // The full-resolution layer is rebuilt for every photo.
    el.photoHD.classList.add('hidden');
    el.photoHD.removeAttribute('src');
    V.fullReady = false;

    renderVerdict(c);
    renderDecisionBadge(c);
    renderActionState(c);
    renderIssues(c);
    renderGroup(c);
    renderMeta(c);
    savePos(c.id);

    el.overlay.innerHTML = '';
    el.zebra.classList.add('hidden');
    S.detail = null;
    highlightCurrent();
    drawHistogram();
    loadDetail(c.id);
    loadFullRes(c);
    placeStamp();
    prefetchAhead();
  }

  function renderVerdict(c) {
    const sug = c.suggest || 'keep';
    // The software's opinion, phrased with the same three words as your own
    // decisions so the two never sound like different vocabularies.
    const main = VERDICT[sug] || '';
    const why = c.suggest_reason && c.suggest_reason !== '未发现明显问题' ? c.suggest_reason : '';
    el.verdictBadge.className = 'verdictBadge ' + sug;
    el.verdictBadge.innerHTML =
      `<span class="vdot"></span><span class="vmain">${esc(main)}</span>` +
      (why ? `<span class="vwhy">${esc(why)}</span>` : '');
  }

  /** Reflect the current photo's decision on the toolbar itself.
   *
   * Without this the toolbar is stateless: every button looks the same no
   * matter what the photo already is, so nothing tells you that pressing 收藏
   * again will TAKE THE MARK BACK rather than add one. The button has to say
   * what it is about to do.
   */
  function renderActionState(c) {
    const d = c ? c.decision : null;
    for (const a of ['keep', 'reject', 'mark']) {
      const b = $(`.act[data-act="${a}"]`);
      if (b) b.classList.toggle('on', d === a);
    }
    const label = $('.act[data-act=mark] .al');
    if (label) label.textContent = d === 'mark'
      ? '取消' + LABEL.mark : LABEL.mark;
    const btn = $('.act[data-act=mark]');
    if (btn) btn.title = (d === 'mark' ? '取消' + LABEL.mark : LABEL.mark)
      + '（键盘 空格，按住可先预览）';
  }

  /** The suggestion above is the software's; this one is yours. */
  function renderDecisionBadge(c) {    const d = c.decision;
    if (!d) { el.decisionBadge.classList.add('hidden'); return; }
    const glyph = { keep: '✓', reject: '✕', mark: '★' }[d] || '';
    const label = OWNED[d];
    el.decisionBadge.className = 'decisionBadge ' + d;
    el.decisionBadge.textContent = `${glyph} ${label}`;
    el.decisionBadge.classList.remove('hidden');
  }

  /** Park the gesture label on the PHOTO, not on the viewport.
   *
   * .previewStamp lives in .photoStage so that it stays visible however the
   * image is panned or zoomed, but the stage is wider than the photo whenever
   * there are letterbox margins. Anchoring it with CSS `right` therefore parked
   * the 收藏 star out in the black border, beside the picture instead of on it.
   *
   * 不要 / 要 hang off the photo's left and right edges, vertically centred,
   * because the label should be where the card is going -- your eye is already
   * there. 收藏 is a mark ON the photo, so it goes in the top-right corner.
   */
  function placeStamp() {
    if (!el.previewStamp || !V.bw) return;
    const o = centred(V.bw, V.bh);
    const s = el.previewStamp.style;
    s.setProperty('--stamp-l', (o.x + 18).toFixed(1) + 'px');
    s.setProperty('--stamp-r', (o.x + V.bw - 18).toFixed(1) + 'px');
    s.setProperty('--stamp-cy', (o.y + V.bh / 2).toFixed(1) + 'px');
    s.setProperty('--stamp-rx', (o.x + V.bw - 14).toFixed(1) + 'px');
    s.setProperty('--stamp-ry', (o.y + 14).toFixed(1) + 'px');
  }

  /** Warm the cache for the photos about to be shown.
   *
   * The card preview is ~71 KB and measured ~250 ms to fetch on this machine,
   * and for that whole time the arriving card sits at 25% opacity with
   * `loading` on it -- which is why a decision looked like it stuttered and
   * *then* the next photo turned up. Fetching the next two while you judge the
   * current one turns the arrival into a decode instead of a download.
   *
   * Only two are held: the Image objects keep decoded bitmaps alive, and the
   * browser's own cache is what carries the bytes forward.
   */
  let _prefetch = [];
  function prefetchAhead() {
    _prefetch = [];
    for (let k = 1; k <= 2; k++) {
      const it = S.queue[S.idx + k];
      if (!it) continue;
      const im = new Image();
      im.decoding = 'async';
      im.src = `/img/${it.id}/card`;
      _prefetch.push(im);
    }
  }



  function renderIssues(c) {
    const list = (S.detail && S.detail.id === c.id && S.detail.issues) || c.issues || [];
    el.issueTags.innerHTML = list.map(i =>
      `<div class="tag ${i.severity || 'info'}">` +
      (i.face_idx != null ? `<span class="fx">脸${i.face_idx + 1}</span>` : '') +
      `<span>${esc(i.label_zh)}</span>` +
      (i.confidence != null ? `<span class="conf">${Math.round(i.confidence * 100)}%</span>` : '') +
      `</div>`).join('');
  }

  function renderGroup(c) {
    if (c.group_size > 1) {
      el.groupBadge.classList.remove('hidden');
      el.groupBadge.textContent = `相似组 ${c.group_rank}/${c.group_size}` +
        (c.group_rank === 1 ? ' · 组内最佳' : '');
    } else {
      el.groupBadge.classList.add('hidden');
    }
  }

  function renderMeta(c) {
    const bits = [c.name];

    // Shooting settings. On a culling pass these decide as much as the picture
    // does -- 1/60s at ISO 6400 tells you why it is soft before you zoom in.
    const shot = [];
    if (c.shutter) shot.push(c.shutter);
    if (c.aperture) shot.push('f/' + (+c.aperture).toFixed(1).replace(/\.0$/, ''));
    if (c.iso) shot.push('ISO ' + c.iso);
    if (c.focal) shot.push(Math.round(c.focal) + 'mm');
    if (shot.length) bits.push(shot.join(' '));

    if (c.taken_at) bits.push(c.taken_at);
    if (c.width) bits.push(`${c.width}×${c.height}`);
    if (c.camera) bits.push(c.camera);

    // Where this frame sits in its own burst, and how long since the previous
    // one -- a 20-minute jump is a different scene, not another take.
    if (c.group_size > 1) bits.push(`连拍 ${c.group_rank}/${c.group_size}`);
    const prev = S.queue[S.idx - 1];
    if (prev && prev.taken_ts && c.taken_ts) {
      const dt = c.taken_ts - prev.taken_ts;
      if (dt >= 0) {
        bits.push(dt < 60 ? `距上一张 ${Math.round(dt)}s`
                          : `距上一张 ${Math.round(dt / 60)}min`);
      }
    }

    el.metaLine.textContent = bits.join('  ·  ');
  }

  async function loadDetail(id) {
    try {
      const d = await api(`/api/photo/${id}`);
      if (!cur() || cur().id !== id) return;
      S.detail = d;
      const c = cur();
      if (c) renderIssues(c);
      renderOverlay();
    } catch (e) { /* ignore */ }
  }

  /* ── full resolution ──
     The old code preloaded the original and then threw it away, so zooming
     just upscaled a 1600px preview. Now the full image is fetched in the
     background and layered on top the moment it decodes. */
  let fullPre = null;

  function loadFullRes(c) {
    if (!c) return;
    const id = c.id;
    const im = new Image();
    fullPre = im;
    if ('decoding' in im) im.decoding = 'async';
    im.onload = () => {
      const now = cur();
      if (!now || now.id !== id) return;      // the user moved on
      if (V.fullReady) return;
      el.photoHD.src = im.src;
      el.photoHD.classList.remove('hidden');
      // NOT gated on el.photoHD.decode(): that promise can stay pending
      // indefinitely in a background tab, which left fullReady false forever
      // and pinned the zoom cap at the 1600px preview (measured 27%, MAD 45+).
      // onload is enough -- verified pixel-identical (MAD 1.26/255) at 100%.
      V.fullReady = true;
      V.natW = im.naturalWidth;
      V.natH = im.naturalHeight;
      updateZoomBadge();
      drawHistogram();
      if (S.showZebra) buildZebra();
    };
    im.onerror = () => { V.fullReady = false; };
    im.src = `/img/${id}/full`;
  }

  /* ═════════════════════════ 缩放 / 平移 ═════════════════════════ */

  function fitStage() {
    const wrap = el.cardWrap.getBoundingClientRect();
    const nw = el.photo.naturalWidth, nh = el.photo.naturalHeight;
    // Prefer the catalogue's dimensions over the loaded preview's.
    //
    // Two reasons, and both matter. The original is the right aspect ratio:
    // 1600x1067 and 6000x4000 differ in the third decimal, and that is enough
    // for object-fit:contain to letterbox by a fraction of a pixel, which makes
    // the compositor resample the entire photo (measured 0.85x edge energy with
    // the preview's aspect, 1.00x with the original's). And unlike naturalWidth
    // they are known the moment a photo is RENDERED, so this can lay out before
    // the preview arrives -- otherwise the arriving card kept the previous
    // photo's box for the ~250ms the preview took to load, and then got resized
    // part-way through its arrival animation.
    const ow = V.origW || nw, oh = V.origH || nh;
    if (!ow || !oh) return;
    const aw = Math.max(80, wrap.width - 40), ah = Math.max(80, wrap.height - 40);
    V.areaW = Math.max(1, wrap.width); V.areaH = Math.max(1, wrap.height);
    V.aspect = ow / oh;
    let bw = Math.min(aw, ah * V.aspect);
    let bh = bw / V.aspect;
    if (bh > ah) { bh = ah; bw = bh * V.aspect; }
    V.bw = Math.max(40, bw); V.bh = Math.max(40, bh);
    if (!V.fullReady && nw && nh) { V.natW = nw; V.natH = nh; }
    if (!V.origW && nw && nh) { V.origW = nw; V.origH = nh; }
    resetView(false);
    // render() runs before the image has decoded, so V.bw is still 0 at that
    // point and the stack peek would never get sized. This is the first moment
    // the geometry is actually known.
    placeStamp();
  }

  /** Offset that centres content of size (w,h) inside the viewport. */
  function centred(w, h) {
    return { x: (V.areaW - w) / 2, y: (V.areaH - h) / 2 };
  }

  /** Size of the image layer at scale s. Height always follows from the exact
      aspect so the box can never disagree with the photo's ratio. */
  function layerSize(s) {
    const w = V.bw * s;
    return { w, h: w / (V.aspect || 1) };
  }

  /* Pan is symmetric around centre: at scale s the content is bw*s wide and
     the viewport areaW, so it may travel (bw*s - areaW)/2 either way before an
     edge would show. Zero when the content already fits. */
  function clampPan(tx, ty, s) {
    const z = layerSize(s);
    const mx = Math.max(0, (z.w - V.areaW) / 2);
    const my = Math.max(0, (z.h - V.areaH) / 2);
    return {
      tx: Math.min(mx, Math.max(-mx, tx)),
      ty: Math.min(my, Math.max(-my, ty)),
    };
  }

  /** Largest scale at which the loaded file still has real pixels to show. */
  function nativeScaleCap() {
    if (!V.bw || !V.natW) return 10;
    return Math.max(1, V.natW / V.bw);
  }

  function updateZoomBadge() {
    if (V.s <= 1.02) { el.zoomBadge.classList.add('hidden'); return; }
    el.zoomBadge.classList.remove('hidden');
    const pct = V.origW ? Math.round((V.bw * V.s) / V.origW * 100)
                        : Math.round(V.s * 100);
    const parts = [`${pct}%`];
    if (V.origW && V.natW && V.natW < V.origW * 0.98) {
      // RAW/HEIC: we are showing the largest preview we could extract, so say so
      parts.push(V.fullReady ? '预览' : '预览加载中');
    }
    parts.push('双击复位');
    el.zoomBadge.textContent = parts.join('  ·  ');
  }

  function applyView(instant) {
    if (!V.bw) return;
    // Height is derived from width through the exact aspect, never rounded
    // independently -- the box must match the photo's ratio precisely or
    // object-fit resamples.
    const w = V.bw * V.s, h = w / (V.aspect || (V.origW / V.origH) || 1);
    const o = centred(w, h);
    el.photoLayer.classList.toggle('nofx', !!instant);
    el.photoLayer.style.width = w.toFixed(3) + 'px';
    el.photoLayer.style.height = h.toFixed(3) + 'px';
    el.photoLayer.style.transform =
      `translate(${(o.x + V.tx).toFixed(2)}px,${(o.y + V.ty).toFixed(2)}px)`;
    el.photoStage.classList.toggle('zoomed', V.s > 1.02);
    updateZoomBadge();
  }

  function resetView(instant) {
    V.s = 1; V.tx = 0; V.ty = 0;
    applyView(instant === undefined ? true : instant);
  }

  /** Cap: never scale past 1 image pixel = 1 screen pixel. Zooming into
      interpolation is just a blur with extra steps. */
  function maxScale() {
    return Math.max(1.02, nativeScaleCap());
  }

  function zoomAt(cx, cy, factor, animate) {
    if (!V.bw) return;
    const ns = Math.min(maxScale(), Math.max(1, V.s * factor));
    if (Math.abs(ns - V.s) < 1e-4) return;
    const a = el.cardWrap.getBoundingClientRect();
    const sx = cx - a.left, sy = cy - a.top;      // viewport-local
    const z0 = layerSize(V.s);
    const o0 = centred(z0.w, z0.h);
    const ux = (sx - o0.x - V.tx) / V.s;           // image-local, 0..bw
    const uy = (sy - o0.y - V.ty) / V.s;
    const z1 = layerSize(ns);
    const o1 = centred(z1.w, z1.h);
    const p = clampPan(sx - o1.x - ux * ns, sy - o1.y - uy * ns, ns);
    V.s = ns; V.tx = p.tx; V.ty = p.ty;
    applyView(!animate);
  }

  /* ═════════════════════════ 鼠标：拖拽 / 平移 ═════════════════════════ */

  let drag = null;

  function onStageDown(e) {
    if (e.button !== 0 || !cur()) return;
    if (V.s > 1.02) {
      drag = { mode: 'pan', x: e.clientX, y: e.clientY, tx: V.tx, ty: V.ty };
      el.photoStage.classList.add('panning');
      el.photoLayer.classList.add('nofx');
    } else {
      drag = { mode: 'swipe', x: e.clientX, y: e.clientY, dx: 0,
               samples: [{ x: e.clientX, y: e.clientY, t: performance.now() }] };
      // A fresh grip always starts from the resting position. After a throw the
      // integrator has left the body far off-centre, and render() zeroes it --
      // but only once the commit callback has run, so this covers the case
      // where the next gesture begins before that.
      if (P.mode === 'idle') { P.x = P.y = P.vx = P.vy = P.a = P.av = 0; }
      // Grabbing the card interrupts the arrival. A running animation outranks
      // inline styles, so leaving cardRise in flight would swallow every
      // transform the drag writes and the card would not move at all.
      el.photoCard.classList.remove('entering');
      // .dragging turns OFF the transition on the card and the progress numbers,
      // so the gesture is 1:1 under the pointer. Removing it on release is what
      // plays the spring home.
      el.photoStage.classList.add('dragging');
      el.photoLayer.classList.add('nofx');
    }
    e.preventDefault();
  }

  /** Current resting transform of the image layer, plus an extra screen offset. */
  function layerTransform(dx, dy, rot) {
    const z = layerSize(V.s);
    const o = centred(z.w, z.h);
    const x = (o.x + V.tx + (dx || 0)).toFixed(2);
    const y = (o.y + V.ty + (dy || 0)).toFixed(2);
    return `translate(${x}px,${y}px)` + (rot ? ` rotate(${rot}deg)` : '');
  }

  function setCardOffset(dx, rot) {
    el.photoCard.style.setProperty('--sx', (dx || 0).toFixed(1) + 'px');
    el.photoCard.style.setProperty('--sr', (rot || 0).toFixed(2) + 'deg');
  }

  /* ═════════════════════════ 拖拽物理 ═════════════════════════

     A real rigid body, integrated by hand. There is no physics engine here on
     purpose: with ONE body, no collisions and a single spring, an engine's
     value -- broadphase, the constraint solver, sleeping, compound shapes -- is
     entirely unused, and it would cost 80 KB (Matter.js, the smallest 2D one)
     plus a licence notice. What actually makes a drag feel physical is:

       1. it moves in BOTH axes, not just horizontally
       2. it LAGS the pointer instead of being welded to it, so it swings
       3. the velocity it had at release carries on afterwards
       4. it spins, and the spin follows the motion

     Semi-implicit Euler over those four is about twenty lines. Units below are
     pixels and milliseconds, and every constant is expressed "per 16.7 ms" and
     raised to the elapsed-time ratio, so the feel does not change with frame
     rate -- a 144 Hz display and a throttled 30 Hz one behave the same. */

  const P = {
    x: 0, y: 0,          // offset from the resting position, px
    vx: 0, vy: 0,        // px per 16.7 ms step
    a: 0, av: 0,         // angle in degrees, angular velocity per step
    tx: 0, ty: 0,        // where the pointer is pulling it
    mode: 'idle',        // idle | drag | coast | home
    fresh: true,         // the next frame has no previous timestamp to use
    raf: 0, last: 0,
  };

  // Tuned for a photograph rather than a crate: light, and quick enough to feel
  // attached while still visibly trailing the finger.
  const P_FOLLOW = 0.34;   // fraction of the remaining distance closed per step
  const P_AIR = 0.992;     // nearly none -- a thrown card is not in treacle
  const P_SPIN = 0.055;    // degrees of spin per px/step of horizontal velocity
  const P_TILT = 0.9;      // how much of the pull turns into lean, in degrees/px
  const P_SETTLE = 0.35;   // stop below this per-step move, in px

  const scale = (base, dt) => Math.pow(base, dt);   // per-step constant -> dt

  function physApply() {
    el.photoCard.style.transform =
      'translate3d(' + P.x.toFixed(1) + 'px,' + P.y.toFixed(1) + 'px,0) ' +
      'rotate(' + P.a.toFixed(2) + 'deg)';
  }

  function physFrame(now) {
    // The first frame after a gesture starts has no previous timestamp to
    // measure against. It gets one ordinary step rather than dt = 0: at dt = 0
    // the body is still sitting at rest on the origin, which the settle test at
    // the bottom reads as "finished" and shuts the loop down before it ever
    // moves. That made a drag completely dead -- no spring, no feedback.
    const dt = P.fresh ? 1 : Math.min(48, now - P.last) / 16.7;
    P.fresh = false;
    P.last = now;

    if (P.mode === 'coast') {
      // Nothing holds it: it keeps the velocity it was thrown with and only the
      // air slows it. This is the part a keyframe animation cannot do -- the
      // direction and the spin are whatever the gesture actually was.
      P.vx *= scale(P_AIR, dt);
      P.vy *= scale(P_AIR, dt);
      P.av *= scale(0.97, dt);
      P.x += P.vx * dt;
      P.y += P.vy * dt;
      P.a += P.av * dt;
    } else {
      // FIRST-ORDER follow, not a spring. A spring is underdamped by nature, so
      // stopping the pointer mid-drag made the card bounce in place -- which is
      // not what a held object does. Exponential approach gives the same lag
      // (the card trails the finger) with no oscillation, ever: each step moves
      // a fixed FRACTION of the remaining distance, so it can only get closer.
      //
      // The throw does not need inertia here: release velocity is measured from
      // the POINTER, so what the card was doing a frame earlier is irrelevant.
      const tx = P.mode === 'drag' ? P.tx : 0;
      const ty = P.mode === 'drag' ? P.ty : 0;
      const k = 1 - scale(1 - P_FOLLOW, dt);      // frame-rate independent
      const dx = (tx - P.x) * k;
      const dy = (ty - P.y) * k;
      P.x += dx;
      P.y += dy;
      P.vx = dx;                                   // kept for the release maths
      P.vy = dy;
      // Spin still comes out of the motion: a card pulled sideways leans.
      const lean = -(tx - P.x) * P_TILT * 0.02;
      P.av += (lean * 0.05 - P.a * 0.03) * dt;
      P.av *= scale(0.88, dt);
      P.a += P.av * dt;
    }

    physApply();
    // The feedback has to be driven from HERE, not from the pointer handler.
    // The body advances on animation frames, so updating the veil only when the
    // pointer moves leaves it a frame behind the card -- and with two quick
    // moves and no frame in between, it never updates at all.
    if (P.mode === 'drag') updateFeedback();

    const spent = P.mode === 'coast'
      ? Math.abs(P.x) > 4000 || Math.abs(P.y) > 4000
      : (Math.abs(P.vx) + Math.abs(P.vy) < P_SETTLE &&
         Math.abs(P.x) + Math.abs(P.y) < 1.5);
    if (spent) { physStop(); return; }
    P.raf = requestAnimationFrame(physFrame);
  }

  /** The veil and the label, keyed off the body's real horizontal position.
   *
   * Only left and right mean anything: you can toss the card wherever you like,
   * but the three judgements are a left/right axis, so the feedback tracks the
   * horizontal component of where the card actually is. */
  function updateFeedback() {
    const hx = P.x;
    const mag = Math.abs(hx);
    const p = mag < DRAG_DEAD ? 0 : Math.min(1, mag / DRAG_COMMIT);
    setDragProgress(p > 0 && hx < 0 ? p : 0, p > 0 && hx > 0 ? p : 0, 0);
    el.previewStamp.style.setProperty('--stamp-dx', hx.toFixed(1) + 'px');
    el.photoStage.classList.toggle('hold-reject', hx < -DRAG_DEAD);
    el.photoStage.classList.toggle('hold-keep', hx > DRAG_DEAD);
    if (p > 0) el.previewStamp.textContent = hx < 0 ? LABEL.reject : LABEL.keep;
  }

  function physStart(mode) {
    P.mode = mode;
    // The integrator writes `transform` every frame, so the card must not have
    // a transition on it: each write would restart the 420 ms spring and the
    // motion would smear into treacle.
    el.photoCard.style.transition = 'none';
    if (!P.raf) {
      P.fresh = true;
      P.raf = requestAnimationFrame(physFrame);
    }
  }

  function physStop() {
    if (P.raf) cancelAnimationFrame(P.raf);
    P.raf = 0;
    P.mode = 'idle';
    // Hand the transition back. A throw that ends by leaving the screen stops
    // the loop on its own, and without this the card would keep
    // `transition: none` forever -- silently killing the keyboard path's spring
    // home. Restoring it here is safe: nothing is changing the transform at this
    // moment, so there is nothing to animate.
    if (el.photoCard) el.photoCard.style.transition = '';
  }

  function physReset() {
    physStop();
    P.x = P.y = P.vx = P.vy = P.a = P.av = P.tx = P.ty = 0;
    // Blank the transform with the transition OFF, force a recalc, then restore.
    //
    // Clearing it while the transition is armed makes the card animate home
    // from wherever the throw left it -- 420 ms of sliding back from the edge.
    // The peek hands over within a few frames (the preview is prefetched), so
    // the card was being revealed part-way through that slide, which is exactly
    // the "next photo slides in from the side" that replaced the rise from the
    // stack.
    el.photoCard.style.transition = 'none';
    el.photoCard.style.transform = '';
    void el.photoCard.offsetWidth;
    el.photoCard.style.transition = '';
  }

  /** Pointer speed in px per ms over the tail of a gesture, on both axes.
   *
   * Uses the oldest and newest sample still in the window rather than the last
   * two moves: a single jittery pair of frames can read as a huge velocity, and
   * then a slow deliberate drag would fire as a flick. The window is short
   * enough that a drag which ENDS in a flick still measures fast.
   */
  function pointerVelocity(samples) {
    if (!samples || samples.length < 2) return { vx: 0, vy: 0 };
    const a = samples[0], b = samples[samples.length - 1];
    const dt = b.t - a.t;
    if (!(dt > 1)) return { vx: 0, vy: 0 };
    return { vx: (b.x - a.x) / dt, vy: (b.y - a.y) / dt };
  }

  function onDragMove(e) {
    if (!drag) return;
    if (drag.mode === 'pan') {
      const p = clampPan(drag.tx + (e.clientX - drag.x), drag.ty + (e.clientY - drag.y), V.s);
      V.tx = p.tx; V.ty = p.ty;
      applyView(true);
      return;
    }
    const dx = e.clientX - drag.x;
    drag.dx = dx;
    // A short window of recent pointer positions. The velocity at RELEASE is
    // what turns a drag into a throw, and it has to be measured over the last
    // few frames -- an average since mousedown would call a slow drag that
    // ended in a flick "slow".
    drag.samples.push({ x: e.clientX, y: e.clientY, t: performance.now() });
    if (drag.samples.length > 6) drag.samples.shift();

    // The pointer is a TARGET, not a position. The body is spring-pulled toward
    // it and lags behind, which is where the weight and the swing come from --
    // welding the card to the cursor (what this used to do) is why a drag felt
    // like moving a rectangle rather than throwing a card.
    P.tx = dx;
    P.ty = e.clientY - drag.y;
    physStart('drag');
    // The loop keeps the feedback in step from here on; this one call just
    // avoids a frame of lag on the very first move.
    updateFeedback();
  }

  function onDragEnd() {
    if (!drag) return;
    const d = drag;
    drag = null;
    el.photoStage.classList.remove('panning');

    if (d.mode === 'pan') { el.photoLayer.classList.remove('nofx'); applyView(false); return; }

    // Whatever happens next, the gesture is over: dropping .dragging re-arms the
    // springs, so the card and the overlay travel home under their own easing.
    el.photoStage.classList.remove('dragging');

    // The release velocity, in px per ms, on BOTH axes. The horizontal part
    // decides (the three judgements are left/right), but the vertical part is
    // carried into the throw: toss the card up and to the left and it goes up
    // and to the left.
    const vel = pointerVelocity(d.samples);
    const power = Math.min(1, Math.abs(vel.vx) / FLING_MAX);

    const flicked = Math.abs(vel.vx) >= FLING_MIN_V &&
                    Math.sign(vel.vx) === Math.sign(P.x || vel.vx);
    const far = Math.abs(P.x) > DRAG_COMMIT;

    if (far || flicked) {
      const action = (P.x < 0 || (flicked && vel.vx < 0)) ? 'reject' : 'keep';

      // Hand the body the velocity it was released with, converted from px/ms
      // into px-per-step and amplified a little so a throw goes somewhere. From
      // here nothing is authored: it coasts, spins and leaves in whatever
      // direction the gesture actually had.
      const boost = 26 + power * 34;
      P.vx = vel.vx * boost;
      P.vy = vel.vy * boost;
      // A card thrown sideways also turns over. The spin comes from the throw,
      // not from a keyframe.
      P.av = -vel.vx * P_SPIN * 60;

      el.photoStage.classList.remove('hold-reject', 'hold-keep');
      setDragProgress(0, 0, 0);
      el.photoLayer.classList.remove('nofx');
      // Deliberately NOT adding RELEASE_CLASS[action]. That class carries a CSS
      // keyframe on `transform`, and a CSS animation outranks an inline style --
      // so it would silently override every transform the integrator writes and
      // the throw would be whatever the keyframe says, not what you threw.
      // The integrator is the exit here.
      //
      // The exit is the integrator, and the arrival is a plain cardRise. The two
      // are NOT animated together any more -- see render().
      physStart('coast');

      // Commit once it is actually off the picture, with a hard deadline so a
      // card thrown straight up still resolves.
      const deadline = performance.now() + 900;
      const wait = () => {
        const gone = Math.abs(P.x) > (V.bw || 600) * 1.1;
        if (P.mode === 'coast' && !gone && performance.now() < deadline) {
          setTimeout(wait, 40);
          return;
        }
        // The peek has already risen into the slot and is showing the next
        // photo at full size. render() must therefore NOT replay the arrival
        // animation -- it starts at scale .955, so replaying it made the card
        // appear in place and then jump back down before rising again.
        physReset();
        el.photoStage.classList.remove(RELEASE_CLASS[action]);
        commitDecision(action);
      };
      setTimeout(wait, 60);
    } else {
      // Under the threshold: let the spring pull it home. No keyframe, no
      // easing curve -- it is the same integrator that was just swinging it.
      physStart('home');
      el.photoStage.classList.remove('hold-reject', 'hold-keep');
      setDragProgress(0, 0, 0);
      setTimeout(() => el.photoLayer.classList.remove('nofx'), 30);
    }
  }

  function onWheel(e) {
    if (!cur() || !V.bw) return;
    e.preventDefault();
    zoomAt(e.clientX, e.clientY, Math.exp(-e.deltaY * 0.0016), false);
  }

  function onDblClick(e) {
    if (!cur()) return;
    if (V.s > 1.02) { resetView(true); return; }
    // 100% means one pixel of the ORIGINAL photo per screen pixel.
    const target = V.origW ? (V.origW / V.bw) : maxScale();
    zoomAt(e.clientX, e.clientY, Math.min(target, maxScale()) / V.s, true);
  }

  /* ═════════════════════════ 按住预览 ═════════════════════════ */

  let hold = null;

  /** Pressing 收藏 on a photo that is already 收藏 takes the mark back. */
  function isUnmark(action) {
    const c = cur();
    return action === 'mark' && !!c && c.decision === 'mark';
  }

  function startHold(action) {
    if (hold || S.animating || !cur() || S.busy) return;
    if (!HOLD_CLASS[action]) return;
    hold = { action, off: isUnmark(action) };
    el.photoStage.classList.add(HOLD_CLASS[action]);
    el.previewStamp.textContent = LABEL[action] || '';
    // The keyboard has no drag to measure, so it drives the same progress
    // numbers straight to 1 -- which means the overlay animates in under the
    // stage's transition instead of snapping.
    if (action === 'mark') setDragProgress(0, 0, 1);
    else if (action === 'reject') setDragProgress(1, 0, 0);
    else setDragProgress(0, 1, 0);
    const btn = $(`.act[data-act="${action}"]`);
    if (btn) btn.classList.add('active');
  }

  function resetHoldVisual() {
    Object.values(HOLD_CLASS).forEach(c => el.photoStage.classList.remove(c));
    Object.values(RELEASE_CLASS).forEach(c => el.photoStage.classList.remove(c));
    el.photoStage.classList.remove('dragging', 'release-mark-off');
    physReset();
    setDragProgress(0, 0, 0);
    el.previewStamp.style.setProperty('--stamp-dx', '0px');
    el.photoCard.style.transform = '';
    setCardOffset(0, 0);
    el.photoLayer.classList.remove('nofx');
    if (V.bw) el.photoLayer.style.transform = layerTransform(0, 0);
    $$('.act.active').forEach(b => b.classList.remove('active'));
    hold = null;
  }

  /** Play the departure animation and resolve when the card is gone. */
  function flyOut(action) {
    S.animating = true;
    return new Promise(resolve => {
      el.photoStage.classList.remove(HOLD_CLASS[action]);
      // The veil has no release rule of its own -- it is pure progress -- so
      // zeroing this is what makes it retreat as the card flies. The stamp is
      // under an animation from here on, so it is unaffected.
      setDragProgress(0, 0, 0);
      // A key press has no velocity behind it, so this stays on the CSS
      // keyframes: there is no gesture to carry. 收藏 is picked up, not thrown.
      el.photoStage.classList.add(RELEASE_CLASS[action]);
      // The card behind rises at the same time, so the two read as one motion.
      setTimeout(() => {
        el.photoStage.classList.remove(RELEASE_CLASS[action]);
        resolve();
      }, EXIT_MS[action] || 300);
    });
  }

  function endHold(commit) {
    if (!hold) return;
    const { action, off } = hold;
    hold = null;
    $$('.act.active').forEach(b => b.classList.remove('active'));

    if (!commit) { resetHoldVisual(); return; }

    if (off) {
      // Taking the mark back: the seal lifts off and the card does not move.
      // 收藏 is the only decision that ADDS something, so undoing it looks like
      // removing that thing -- and since the photo is not being filed away,
      // there is no reason to jump to the next one.
      S.animating = true;
      el.photoStage.classList.add('release-mark-off');
      setTimeout(() => {
        resetHoldVisual();
        S.animating = false;
        commitClear();
      }, UNMARK_MS);
      return;
    }

    el.photoStage.classList.remove(HOLD_CLASS[action]);
    flyOut(action).then(() => { S.animating = false; commitDecision(action); });
  }

  /* ═════════════════════════ 决策 ═════════════════════════ */

  /** Write a decision to the server, OFF the critical path.
   *
   * This used to be awaited BEFORE render(), so the sequence was: outgoing card
   * flies away (400ms), then the stage sits empty for a whole round-trip, then
   * the next card finally starts rising. The round-trip measured 3.7ms median
   * but 196.7ms at worst, and any of those outliers is a visible catch.
   *
   * The client state is already updated optimistically by the caller, so the
   * only thing this does is persist it and shout if the write fails.
   */
  let savesInFlight = 0;
  async function saveDecision(id, action) {
    savesInFlight++;
    try {
      await api('/api/decide', { method: 'POST', body: JSON.stringify({ id, action }) });
    } catch (e) {
      toast('保存失败，这一张可能没记上', 'err');
    }
    if (--savesInFlight === 0) loadState();
  }

  function commitDecision(action) {
    const c = cur();
    S.animating = false;
    if (!c) { resetHoldVisual(); return; }

    const at = S.idx;
    // Show the next card FIRST. Awaiting the server here left nothing on screen
    // to animate: the outgoing card had already gone and the incoming one had
    // not been rendered yet.
    c.decision = action;
    markListItem(at, action);
    S.idx++;
    render();
    saveDecision(c.id, action);
  }

  /** Take back the 收藏 mark. Stays on the photo: nothing is being filed away. */
  async function commitClear() {
    const c = cur();
    if (!c || S.busy) { resetHoldVisual(); return; }
    S.busy = true;
    try { await api('/api/decide', { method: 'POST', body: JSON.stringify({ id: c.id, action: 'clear' }) }); }
    catch (e) { toast('保存失败', 'err'); }

    c.decision = null;
    markListItem(S.idx, null);
    S.busy = false;
    // Deliberately NOT render(): that would replay the arrival animation and
    // look like a new photo had loaded, when all that changed is a badge.
    renderDecisionBadge(c);
    renderActionState(c);
    renderStats(S.state);
    toast('已取消' + LABEL.mark);
  }

  /** A direct, animated decision (toolbar / grid / click). */
  async function decide(action) {
    if (S.busy || !cur()) return;
    await flyOut(action);
    commitDecision(action);
  }

  async function undo() {
    try {
      const r = await api('/api/undo', { method: 'POST' });
      if (!r.ok) { toast('没有可撤销的操作'); return; }
      toast('已撤销');
      const id = r.result.photo_id;
      const at = S.queue.findIndex(x => x.id === id);
      if (at >= 0) {
        S.queue[at].decision = r.result.restored_to || null;
        markListItem(at, S.queue[at].decision);
        S.idx = at;
        render();
      } else {
        await loadQueue();
      }
      loadState();
    } catch (e) { toast('撤销失败', 'err'); }
  }

  /** Navigation only -- it never touches the decision. */
  function slide(fromX) {
    el.photoStage.animate(
      [{ transform: `translateX(${fromX}px)`, opacity: .35 }, { transform: 'none', opacity: 1 }],
      { duration: 190, easing: 'cubic-bezier(.22,.61,.36,1)' });
  }

  function prevPhoto() {
    if (S.idx <= 0) { toast('已经是第一张了'); return; }
    S.idx--;
    slide(-40);
    render();
  }

  function nextPhoto() {
    if (S.idx >= S.queue.length - 1) { toast('已经是最后一张了'); return; }
    S.idx++;
    slide(40);
    render();
  }

  function runAction(a) {
    if (a === 'undo') return undo();
    if (a === 'prev') return prevPhoto();
    if (a === 'next') return nextPhoto();
    if (HOLD_CLASS[a]) {
      // Mouse path: a click IS the intent, so there is nothing to preview.
      // Play the hold state for one frame anyway so the veil and stamp are
      // part of the same gesture rather than appearing only for keyboards.
      startHold(a);
      setTimeout(() => endHold(true), 90);
      return;
    }
    return decide(a);
  }

  /* ═════════════════════════ overlays ═════════════════════════ */

  function renderOverlay() {
    if (!S.showOverlay || !S.detail || !S.detail.faces) {
      el.overlay.innerHTML = '';
      el.overlay.classList.add('hidden');
      return;
    }
    el.overlay.classList.remove('hidden');
    const parts = [];
    for (const f of S.detail.faces) {
      const yaw = Math.abs(f.yaw || 0);
      const closed = Math.max(f.blink_l || 0, f.blink_r || 0) >= 0.55;
      const col = closed ? '#ff5c57' : (yaw > 32 ? '#8b949e' : '#58a6ff');
      parts.push(`<rect x="${f.x}" y="${f.y}" width="${f.w}" height="${f.h}" fill="none"
        stroke="${col}" stroke-width="1.6" vector-effect="non-scaling-stroke"/>`);
      const lm = f.landmarks || {};
      for (const [key, bv] of [['r_eye', f.blink_r], ['l_eye', f.blink_l]]) {
        const b = lm[key];
        if (!b) continue;
        const v = bv || 0;
        const c = v >= 0.55 ? '#ff5c57' : (v >= 0.30 ? '#e3b341' : '#7ee787');
        parts.push(`<rect x="${b[0]}" y="${b[1]}" width="${b[2]}" height="${b[3]}" fill="none"
          stroke="${c}" stroke-width="1.4" vector-effect="non-scaling-stroke"/>`);
      }
    }
    el.overlay.innerHTML = parts.join('');
  }

  /** The image the user is actually looking at (HD layer when it has landed). */
  function visibleImage() {
    return (V.fullReady && el.photoHD.naturalWidth) ? el.photoHD : el.photo;
  }

  function drawHistogram() {
    const cv = el.histoCanvas, ctx = cv.getContext('2d');
    const W = cv.width, H = cv.height;
    ctx.clearRect(0, 0, W, H);
    const img = visibleImage();
    if (!img.naturalWidth) return;
    const sw = 220, sh = Math.max(1, Math.round(sw * img.naturalHeight / img.naturalWidth));
    const tmp = document.createElement('canvas');
    tmp.width = sw; tmp.height = sh;
    const tc = tmp.getContext('2d');
    tc.drawImage(img, 0, 0, sw, sh);
    let data;
    try { data = tc.getImageData(0, 0, sw, sh).data; } catch (e) { return; }
    const bins = new Array(64).fill(0);
    for (let i = 0; i < data.length; i += 4) {
      const y = (data[i] * 0.299 + data[i + 1] * 0.587 + data[i + 2] * 0.114) | 0;
      bins[y >> 2]++;
    }
    const max = Math.max(1, ...bins);
    for (let i = 0; i < 64; i++) {
      const h = bins[i] / max * (H - 6);
      let color = '#7d8590';
      if (i >= 62) color = '#f0883e';
      if (i <= 1) color = '#58a6ff';
      ctx.fillStyle = color;
      ctx.fillRect(i / 64 * W, H - h, Math.max(1, W / 64 - 0.6), h);
    }
  }

  function buildZebra() {
    const img = visibleImage();
    if (!img.naturalWidth) return;
    const sw = Math.min(1000, img.naturalWidth);
    const sh = Math.max(1, Math.round(sw * img.naturalHeight / img.naturalWidth));
    const tmp = document.createElement('canvas');
    tmp.width = sw; tmp.height = sh;
    const tc = tmp.getContext('2d', { willReadFrequently: true });
    tc.drawImage(img, 0, 0, sw, sh);
    let d;
    try { d = tc.getImageData(0, 0, sw, sh); } catch (e) { return; }
    const px = d.data, out = tc.createImageData(sw, sh), o = out.data;
    for (let y = 0; y < sh; y++) {
      for (let x = 0; x < sw; x++) {
        const i = (y * sw + x) * 4;
        const lum = px[i] * 0.299 + px[i + 1] * 0.587 + px[i + 2] * 0.114;
        const blow = lum >= 250, crush = lum <= 5;
        if ((blow || crush) && ((x + y) % 12 < 6)) {
          o[i] = blow ? 255 : 40; o[i + 1] = blow ? 190 : 120;
          o[i + 2] = blow ? 40 : 255; o[i + 3] = 210;
        }
      }
    }
    const z = el.zebra;
    z.width = sw; z.height = sh;
    z.getContext('2d').putImageData(out, 0, 0);
    z.classList.remove('hidden');
  }

  /* ═════════════════════════ 网格 ═════════════════════════ */

  async function openGrid() {
    el.gridView.classList.remove('hidden');
    $('#appView').classList.add('hidden');
    await loadGrid();
  }

  function closeGrid() {
    el.gridView.classList.add('hidden');
    $('#appView').classList.remove('hidden');
    fitStage();
  }

  async function loadGrid() {
    S.filter = el.gridFilter.value || S.filter;
    S.sort = el.gridSort.value;
    let q;
    try { q = await api(`/api/queue?filter=${encodeURIComponent(S.filter)}&sort=${encodeURIComponent(S.sort)}`); }
    catch (e) { return; }
    const items = (q.items || []).slice(0, 1500);
    el.gridCount.textContent = `${q.total} 张` + (q.total > items.length ? `（显示前 ${items.length}）` : '');
    el.grid.innerHTML = items.map(c => {
      const flags = (c.issues || []).slice(0, 3).map(i =>
        `<span class="flag ${i.severity}">${esc(i.label_zh)}</span>`).join('');
      return `<div class="cell ${c.decision || ''}" data-id="${c.id}">
        <img loading="lazy" src="/img/${c.id}/small" alt="">
        <div class="flags">${flags}</div>
        ${c.group_size > 1 ? `<div class="gmark">${c.group_rank}/${c.group_size}</div>` : ''}
        <div class="cap">${esc(c.name)}</div>
      </div>`;
    }).join('');
  }

  function onGridClick(e) {
    const cell = e.target.closest('.cell');
    if (!cell) return;
    const id = +cell.dataset.id;
    if (e.ctrlKey || e.metaKey || e.shiftKey) {
      S.sel.has(id) ? S.sel.delete(id) : S.sel.add(id);
      cell.classList.toggle('sel');
      return;
    }
    const at = S.queue.findIndex(x => x.id === id);
    closeGrid();
    if (at >= 0) { S.idx = at; render(); } else loadQueue();
  }

  async function decideSelected(action) {
    if (!S.sel.size) { toast('先 Ctrl+点击选中一些照片'); return; }
    const ids = Array.from(S.sel);
    await api('/api/decide', { method: 'POST', body: JSON.stringify({ ids, action }) });
    toast(`已把 ${ids.length} 张标为「${LABEL[action]}」`);
    S.sel.clear();
    loadQueue();
  }

  /* ═════════════════════════ 应用决策 ═════════════════════════ */

  async function applyDialog() {
    let pv;
    try { pv = await api('/api/apply/preview?mode=quarantine'); }
    catch (e) { toast('读取失败', 'err'); return; }
    if (!pv.count) { toast('还没有标记为「' + LABEL.reject + '」的照片'); return; }
    const ro = S.state && S.state.read_only;
    el.sheet.innerHTML = `
      <h2>应用决策</h2>
      <p class="muted small">筛选过程没有动过任何文件。下面是即将执行的唯一一次文件操作。</p>
      <h3>将把 <b style="color:#ff8b84">${pv.count}</b> 张照片移动到</h3>
      <p><code>${esc(pv.dest)}</code></p>
      <p class="muted small">共约 ${pv.total_mb} MB · ${LABEL.keep} ${pv.keep_count} 张 · ${LABEL.mark} ${pv.mark_count} 张</p>
      <p class="muted small" style="margin-top:12px">扫一眼下面这些照片，确认没有误判：</p>
      <div class="applyGrid">
        ${pv.items.map(i => `<img loading="lazy" src="/img/${i.id}/small" title="${esc(i.rel_path)}">`).join('')}
      </div>
      ${pv.truncated ? `<p class="muted small">…还有 ${pv.truncated} 张未显示</p>` : ''}
      ${ro ? `<p class="muted small" style="color:#e3b341">本库以只读方式打开，不会移动文件。</p>` : ''}
      <div class="rowBtns">
        <button class="btn ghost" id="apCancel">取消</button>
        <button class="btn ghost" id="apXmp">只写 XMP 标记（不动文件）</button>
        <button class="btn primary" id="apGo" ${ro ? 'disabled' : ''}>确认移动 ${pv.count} 张</button>
      </div>`;
    el.modal.classList.remove('hidden');
    $('#apCancel').onclick = closeModal;
    $('#apXmp').onclick = () => doApply('xmp');
    if (!ro) $('#apGo').onclick = () => doApply('quarantine');
  }

  async function doApply(mode) {
    try {
      const r = await api('/api/apply', { method: 'POST', body: JSON.stringify({ mode, confirm: true }) });
      if (!r.ok) { toast(r.error || '失败', 'err'); return; }
      closeModal();
      toast(`已移动 ${r.moved} 张到隔离文件夹，可随时回滚`, 'warn');
      await loadQueue();
      loadState();
      showRollback(r.batch, r.moved);
    } catch (e) { toast('失败', 'err'); }
  }

  function showRollback(batch, n) {
    el.sheet.innerHTML = `
      <h2>完成</h2>
      <p>已把 <b>${n}</b> 张照片移动到隔离文件夹。原照片没有被删除。</p>
      <p class="muted small">想反悔的话，随时点下面这个按钮，文件会回到原来的位置。</p>
      <div class="rowBtns">
        <button class="btn ghost" id="rbClose">关闭</button>
        <button class="btn primary" id="rbGo">撤销这次移动（回滚 ${n} 张）</button>
      </div>`;
    el.modal.classList.remove('hidden');
    $('#rbClose').onclick = closeModal;
    $('#rbGo').onclick = async () => {
      const r = await api('/api/rollback', { method: 'POST', body: JSON.stringify({ batch }) });
      toast(r.ok ? `已回滚 ${r.restored} 张` : (r.error || '回滚失败'), r.ok ? '' : 'err');
      closeModal();
      await loadQueue();
      loadState();
    };
  }

  function closeModal() { el.modal.classList.add('hidden'); }

  /* ═════════════════════════ 首次引导 ═════════════════════════ */

  function showCoachOnce() {
    let seen = null;
    try { seen = localStorage.getItem('guopian.coach'); } catch (e) { seen = null; }
    if (seen !== '1' && seen !== 'never') el.coach.classList.remove('hidden');
  }

  /* ═════════════════════════ 绑定 ═════════════════════════ */

  let bound = false;
  function bind() {
    if (bound) return;
    bound = true;
    grab();

    // Bottom toolbar. The three big buttons behave like their keys do -- hold
    // to preview, release to commit -- so mouse and keyboard stay one gesture.
    // The small ones act on click because there is nothing to preview.
    $$('.act[data-act]').forEach(b => {
      const act = b.dataset.act;
      b.addEventListener('mousedown', e => { e.preventDefault(); startHold(act); });
      b.addEventListener('mouseenter', e => { if (e.buttons === 1) startHold(act); });
    });
    $$('.act2[data-act]').forEach(b => {
      b.addEventListener('click', () => runAction(b.dataset.act));
    });
    document.addEventListener('mouseup', () => { if (hold) endHold(true); });

    $('#btnGrid').onclick = openGrid;
    $('#btnGridClose').onclick = closeGrid;
    $('#btnTriage').onclick = () => el.triage.classList.toggle('hidden');
    $('#btnHelp').onclick = () => el.help.classList.remove('hidden');
    $('#btnApply').onclick = applyDialog;
    $('#hintMore').onclick = () => el.help.classList.remove('hidden');
    $('#helpClose').onclick = () => el.help.classList.add('hidden');
    $('#listHide').onclick = () => setList(false);
    $('#listShow').onclick = () => setList(true);
    el.listJump.onclick = () => {
      const at = S.queue.findIndex(c => !c.decision);
      if (at < 0) { toast('这个列表里都决定完了'); return; }
      const before = S.idx;
      S.idx = at;
      render();
      toast(before === at ? '当前就是这一张' : `跳到第 ${at + 1} 张`);
    };

    $('#coachOk').onclick = () => {
      el.coach.classList.add('hidden');
      try { localStorage.setItem('guopian.coach', '1'); } catch (e) {}
    };
    $('#coachNever').onclick = () => {
      el.coach.classList.add('hidden');
      try { localStorage.setItem('guopian.coach', 'never'); } catch (e) {}
    };
    el.coach.onclick = (e) => { if (e.target === el.coach) $('#coachOk').click(); };

    el.gridSort.onchange = () => { S.sort = el.gridSort.value; loadQueue(); };
    el.gridFilter.onchange = () => { S.filter = el.gridFilter.value; loadQueue(); };
    el.grid.onclick = onGridClick;
    $('#gridDecideKeep').onclick = () => decideSelected('keep');
    $('#gridDecideReject').onclick = () => decideSelected('reject');

    el.photoStage.addEventListener('mousedown', onStageDown);
    el.photoStage.addEventListener('dblclick', onDblClick);
    el.cardWrap.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('mousemove', onDragMove);
    window.addEventListener('mouseup', onDragEnd);
    // The arrival class only exists to carry the keyframes. Drop it when they
    // are done, so nothing is left applying an animation over style.transform.
    el.photoCard.addEventListener('animationend', e => {
      if (e.animationName === 'cardRise') el.photoCard.classList.remove('entering');
    });

    window.addEventListener('resize', () => { if (V.natW) fitStage(); });
    window.addEventListener('keydown', onKeyDown, true);
    window.addEventListener('keyup', onKeyUp, true);
    window.addEventListener('blur', () => { if (hold) endHold(false); if (drag) onDragEnd(); });
    el.photo.addEventListener('load', () => { if (V.natW !== el.photo.naturalWidth) fitStage(); });
  }

  function setList(open) {
    S.listOpen = open;
    el.listPane.classList.toggle('hidden', !open);
    el.listShow.classList.toggle('hidden', open);
    setTimeout(() => { if (V.natW) fitStage(); }, 30);
    setTimeout(() => { if (V.natW) fitStage(); }, 210);
  }

  // Three decisions, hold-to-preview. J/K mirror the arrows for people who
  // keep their hand on the home row.
  const HOLD_KEYS = { ArrowLeft: 'reject', j: 'reject', J: 'reject',
                      ArrowRight: 'keep', k: 'keep', K: 'keep',
                      ' ': 'mark', Spacebar: 'mark' };
  // Navigation and undo fire on keydown; they change nothing about a photo.
  const TAP_KEYS = { ArrowUp: 'prev', ArrowDown: 'next',
                     Backspace: 'undo', Delete: 'undo' };

  function overlayOpen() {
    return !el.modal.classList.contains('hidden') ||
           !el.help.classList.contains('hidden') ||
           !el.coach.classList.contains('hidden') ||
           !el.browser.classList.contains('hidden');
  }

  function onKeyDown(e) {
    if (e.key === 'Escape') {
      el.help.classList.add('hidden');
      if (!el.modal.classList.contains('hidden')) closeModal();
      if (!el.gridView.classList.contains('hidden')) closeGrid();
      if (hold) endHold(false);
      resetView(true);
      return;
    }
    if (overlayOpen()) return;
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
    // Only the HOME screen ignores shortcuts. This used to test whether
    // #appView was hidden -- but openGrid() hides it too, so opening the grid
    // silently killed every key on the page, including the G that was supposed
    // to close it again.
    if (!$('#homeView').classList.contains('hidden')) return;

    if (e.ctrlKey && (e.key === 'z' || e.key === 'Z')) { e.preventDefault(); undo(); return; }
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.repeat) return;

    if (!el.gridView.classList.contains('hidden')) {
      if (e.key === 'g' || e.key === 'G') closeGrid();
      return;
    }

    const holdAct = HOLD_KEYS[e.key];
    if (holdAct) { e.preventDefault(); startHold(holdAct); return; }
    const tapAct = TAP_KEYS[e.key];
    if (tapAct) { e.preventDefault(); runAction(tapAct); return; }

    switch (e.key) {
      case 'z': case 'Z':
        if (V.s <= 1.02) {
          const r = el.cardWrap.getBoundingClientRect();
          const target = V.origW ? (V.origW / V.bw) : maxScale();
          zoomAt(r.left + r.width / 2, r.top + r.height / 2,
                 Math.min(target, maxScale()) / V.s, true);
          S.peekZoom = true;
        }
        break;
      case 'i': case 'I':
        S.showOverlay = !S.showOverlay; renderOverlay();
        toast('人脸框：' + (S.showOverlay ? '开（仅用于核对，会自动关掉）' : '关'));
        if (S.showOverlay) setTimeout(() => {
          if (S.showOverlay) { S.showOverlay = false; renderOverlay(); }
        }, 4000);
        break;
      case 'p': case 'P':
        S.showZebra = !S.showZebra;
        if (S.showZebra) { buildZebra(); toast('过曝斑马纹：开'); }
        else { el.zebra.classList.add('hidden'); toast('过曝斑马纹：关'); }
        break;
      case '0': resetView(true); break;
      case 'g': case 'G': openGrid(); break;
      case 'l': case 'L': setList(!S.listOpen); break;
      case 'c': case 'C': compareNext(); break;
      case 'f': case 'F':
        if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(() => {});
        else document.exitFullscreen();
        break;
      case '?': el.help.classList.remove('hidden'); break;
    }
  }

  function onKeyUp(e) {
    if (e.key === 'z' || e.key === 'Z') {
      if (S.peekZoom) { S.peekZoom = false; resetView(true); }
      return;
    }
    if (!hold) return;
    if (HOLD_KEYS[e.key] === hold.action) { e.preventDefault(); endHold(true); }
  }

  function compareNext() {
    const c = cur();
    if (!c || !c.group_id) { toast('这张不在相似组里'); return; }
    const mates = S.queue.filter(x => x.group_id === c.group_id);
    if (mates.length < 2) { toast('相似组里只有这一张在当前列表'); return; }
    const pos = mates.findIndex(x => x.id === c.id);
    S.idx = S.queue.findIndex(x => x.id === mates[(pos + 1) % mates.length].id);
    render();
    toast(`相似组 ${pos + 1}/${mates.length}`);
  }

  return { start, stop, attach, loadQueue, closeModal, setList, setLabels };
})();
window.App = App;
